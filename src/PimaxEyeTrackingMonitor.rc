#include <winver.h>

// Program icon (eye_tracking.ico, rendered from eye_tracking.svg).
1 ICON "eye_tracking.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "FileDescription", "Pimax Eye Tracking Monitor"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductName", "Pimax Eye Tracking Monitor"
            VALUE "ProductVersion", "1.0.0"
            VALUE "LegalCopyright", "Copyright (c) 2026 jcooray. MIT licence."
            VALUE "OriginalFilename", "PimaxEyeTrackingMonitor.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END
